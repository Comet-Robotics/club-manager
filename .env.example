SECRET_KEY = 'DJANGO_SECRET_KEY'

## External PostgreSQL: comment out DEV_PGDATA below and uncomment these instead
# DB_NAME = 'DB_NAME'
# DB_USER = 'DB_USERNAME'
# DB_PASSWORD = 'DB_PASSWORD'
# DB_PORT = '5432'
# DB_HOST = 'localhost'

# Local dev database (default): the app installs and runs its own PostgreSQL instance with its data at this path. Created on first use, reused after that.
DEV_PGDATA = './.postgresql_data'

# Already have PostgreSQL you'd rather use? Set DEV_PG_BIN_DIR to that install
# (either its root directory or its bin directory) and setup runs your dev
# database from it instead of installing one. Useful when `mise install
# postgres@14` can't provide PostgreSQL for your platform, or when you want to
# match a specific version. Setup still manages the database itself - it just
# uses these binaries. Examples:
# DEV_PG_BIN_DIR = '/usr/lib/postgresql/14'
# DEV_PG_BIN_DIR = '/opt/homebrew/opt/postgresql@14'
# DEV_PG_BIN_DIR = 'C:\Program Files\PostgreSQL\14'

DEBUG = 1
STATIC_ROOT = './static' # for a prod deployment using nginx, this should be set to /var/www/static

# Leave unset to use the per-user platform data directory. For a prod deployment using nginx,
# set this to a path nginx's worker can traverse, Like the default one we have set.
# MEDIA_ROOT = '/var/www/media'

SQUARE_APPLE_MERCHANT_ID = ''

API_SECRET = 'randomly-generated-api-secret'
DISCORD_API_PORT = 2468
BOT_API_HOST = 'http://localhost:${DISCORD_API_PORT}'

DISCORD_TOKEN = 'DISCORD_BOT_TOKEN'
DISCORD_SERVER_ID = '0'
DISCORD_BOT_LOG_CHANNEL_ID = '0'
DISCORD_OFFICER_ROLE_ID = '0'
DISCORD_PROJECT_MANAGER_ROLE_ID = '0'
DISCORD_TEAM_LEAD_ROLE_ID = '0'
DISCORD_MEMBER_ROLE_ID = '0'

SMTP_SERVER = 'smtp.sendgrid.net'
SMTP_PORT = 587
SMTP_USER = 'apikey'
SMTP_PASS = 'SENDGRID_API_KEY'
EMAIL_FROM = 'email@domain.com'

# 0 for disable, 1 for enable
ENABLE_SQUARE_PAYMENTS=0

PUBLIC_URL='http://127.0.0.1:8000'

# --- Sentry (error reporting) ---
# Sentry never runs when DEBUG is on, so none of this applies to local development.
#
# Instances report to Comet Robotics' shared Sentry project by default, tagged with a
# tenant so deployments can be told apart. Nothing below needs to be set for that to work.
#
# SENTRY_ENABLED = 0                      # opt this instance out of reporting entirely
# SENTRY_DSN = ''                         # report to a different Sentry project (empty also disables)
# SENTRY_TENANT = 'comet-robotics'        # defaults to the PUBLIC_URL hostname
# SENTRY_ENVIRONMENT = 'production'       # e.g. 'staging'
# SENTRY_RELEASE = 'club-manager@1.0.0'   # auto-detected from the git SHA when unset
# SENTRY_TRACES_SAMPLE_RATE = 0.2         # raise for more trace detail, lower to cut volume
# SENTRY_PROFILE_SESSION_SAMPLE_RATE = 0.5 # set to 0 to disable profiling entirely
# SENTRY_DEBUG_ENDPOINT = 1               # routes /sentry-debug/, which raises on purpose
