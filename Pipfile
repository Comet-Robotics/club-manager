[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
python-dotenv = "~=1.2.2"
django = "~=5.2.17"
py-cord = "~=2.6.0"
django-extensions = "~=3.2.3"
django-rename-app = "~=0.1.7"
django-tables2 = "2.7.0"
django-computedfields = "~=0.2.6"
django-admin-list-filter-dropdown = "~=1.0.3"
configparser = "~=7.1.0"
squareup = "~=38.0.0.20240821"
psycopg2-binary = "~=2.9.9"
gunicorn = "~=23.0.0"
requests = "~=2.33.0"
beautifulsoup4 = "~=4.12.3"
django-more-admin-filters = "*"
tqdm = "*"
django-storages = "*"
pillow = "*"
boto3 = "*"
async-timeout = "*"
django-multiselectfield = "*"
django-colorfield = "*"
platformdirs = "*"
fastapi = "*"
uvicorn = "*" # no [standard] extras: they pull uvloop, which has no Windows build, and discord_bot.py sets loop="asyncio" anyway
django-debug-toolbar = "*"
django-naomi = "*"
css-inline = "*"
inscriptis = "*"
django-post-office = "*"
django-ratelimit = "*"
# 2.62+ required for `trace_lifecycle="stream"`; 2.35+ for `enable_logs`. The django
# extra pulls in the complementary packages; FastAPI and asyncio need no extra.
sentry-sdk = {extras = ["django"], version = ">=2.62,<3"}
# Transitive dependency of squareup -> apimatic-core (requires >=68). Pinned past
# GHSA-xmj3-9gf7-h52w: setuptools <84.1.0 can write outside the install directory
# when unpacking a crafted wheel's namespace_packages.txt.
setuptools = "*"
segno = "*"

[dev-packages]
types-beautifulsoup4 = "*"
types-requests = "*"
django-types = "*"
django-stubs-ext = "*"
ruff = "*"
pylint = "*"
pylint-django = "*"
pylint-per-file-ignores = "*"
mypy = "*"
django-stubs = "*"
types-markdown = "*"
