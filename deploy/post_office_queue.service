[Unit]
Description=Deliver queued Club Manager email
# Transactional mail is sent inline (POST_OFFICE["DEFAULT_PRIORITY"] = "now"), so this queue is
# normally empty. It picks up the exceptions: scheduled mail, retries of a send that failed while
# the SMTP provider was down, and anything an officer requeues from the Post Office admin.
After=network.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/clubManager
ExecStart=pipenv --python /root/.pyenv/shims/python run python manage.py send_queued_mail
