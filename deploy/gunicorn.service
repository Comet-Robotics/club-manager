[Unit]
Description=gunicorn daemon
Requires=gunicorn.socket
After=network.target

[Service]
User=root
WorkingDirectory=/root/clubManager
# mise exec puts the Python from .python-version and the pipenv from mise.toml on PATH, so
# this unit never has to name an interpreter. Absolute path: a system unit's PATH is only
# /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin. deploy/init.sh puts mise there.
ExecStart=/usr/local/bin/mise exec -- pipenv run gunicorn --bind unix:/run/gunicorn.sock clubManager.wsgi --access-logfile - --workers 3

[Install]
WantedBy=multi-user.target